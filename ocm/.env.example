# OCM non-secret configuration. Copy to .env (gitignored) and fill in.
# Never put an AWS key, an API key or a token in this file or in .env.
# Real secrets go in AWS Secrets Manager / SSM Parameter Store.

# --- identity (must match ocm/.envrc) ---
AWS_PROFILE=ocm
AWS_REGION=us-west-2

# --- naming ---
OCM_PROJECT_TAG=ocm
OCM_ENV=alpha

# --- public endpoints (see docs/DNS.md) ---
OCM_API_HOST=api.ocm.getdasha.com
OCM_CONSOLE_HOST=ocm.getdasha.com

# --- filled in as resources are created ---
OCM_ACCOUNT_ID=            # real value lives in .deploy.env (gitignored)
OCM_ACM_CERT_ARN=          # real value lives in .deploy.env (gitignored)
OCM_GATEWAY_ENDPOINT=

# --- EC2 Mac provider host (see docs/AWS-ACCOUNT.md §2) ---
# 24-hour minimum allocation. Releasing the HOST is what stops the bill.
OCM_MAC_INSTANCE_TYPE=mac2-m2.metal
OCM_MAC_HOST_ID=

# --- consumer side, for local testing against the gateway ---
# OPENAI_BASE_URL=https://api.ocm.getdasha.com/v1
# OPENAI_API_KEY=  <- from the developer console, never committed
