OCM_REGION=us-west-2
OCM_BUCKET=ocm-artifacts-000000000000
OCM_GW_INSTANCE=i-0000000000000000
OCM_MAC_INSTANCE=i-0000000000000000
OCM_MAC_HOST=h-0000000000000000
OCM_API=https://api.example.com
OCM_CONSOLE=https://console.example.com
